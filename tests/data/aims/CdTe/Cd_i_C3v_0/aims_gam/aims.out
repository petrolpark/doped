  #
  ##################################################################################
  #     valence basis states
      valence      5  s   2.
      valence      5  p   4.
      valence      4  d  10.
  #     ion occupancy
      ion_occ      5  s   1.
      ion_occ      5  p   3.
      ion_occ      4  d  10.
