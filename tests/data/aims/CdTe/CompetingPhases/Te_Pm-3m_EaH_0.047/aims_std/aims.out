  occupation_type                                   methfessel-paxton 0.2 1
  sc_accuracy_etot                                  1e-06
  sc_iter_limit                                     100
  relax_geometry                                    bfgs 0.01
  xc                                                hse06 0.2
  hse_unit                                          A
  hybrid_xc_coeff                                   0.345
  relax_unit_cell                                   full
  k_grid_density                                    6.0
  #===============================================================================
  
  ################################################################################
  #
  #  FHI-aims code project
  #  VB, Fritz-Haber Institut, 2009
  #
  #  Suggested "light" defaults for Te atom (to be pasted into control.in file)
  #  Be sure to double-check any results obtained with these settings for post-processing,
  #  e.g., with the "tight" defaults and larger basis sets.
  #
  #  2020/09/22 Added f function to light settings to improve bulk properties of In-I.
  #
  ################################################################################
    species               Te
  #     global species definitions
    nucleus               52.0
    mass                  127.6
  #
    l_hartree             4
  #
    cut_pot               3.5 1.5 1.0
    basis_dep_cutoff      0.0001
  #
    radial_base    64   5.0000
    radial_multiplier        1
    angular_grids  specified
    division       0.1259  110
    division       0.8959  194
    division       0.9864  302
    outer_grid     302
  ##################################################################################
  #
  #  Definition of "minimal" basis
  #
  ##################################################################################
  #     valence basis states
      valence      5  s   2.
      valence      5  p   4.
      valence      4  d  10.
  #     ion occupancy
      ion_occ      5  s   1.
      ion_occ      5  p   3.
      ion_occ      4  d  10.
